 .../riscv/configs/k1_amdgpu_modules_defconfig | 401 ++++++++++++++++++
 2 files changed, 784 insertions(+)
 create mode 100644 arch/riscv/configs/k1_amdgpu_defconfig
 create mode 100644 arch/riscv/configs/k1_amdgpu_modules_defconfig

